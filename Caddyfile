exomusica.com {
	root * /srv/frontend

	# Compressed responses for text-like types only; the audio and images are already compressed.
	encode zstd gzip {
		match {
			header Content-Type text/* application/json* application/javascript* image/svg+xml*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' wss: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:3001
	}
	handle /ws/* {
		reverse_proxy backend:3001
	}
	handle /uploads/* {
		reverse_proxy backend:3001
	}
	handle /o/* {
		reverse_proxy backend:3001
	}

	@bots header_regexp bot User-Agent "bot|facebookexternalhit|Twitterbot|Discordbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Googlebot"
	handle @bots {
		rewrite * /embed{path}
		reverse_proxy backend:3001
	}

	# Hashed build files never change, so they are cached for a year. A missing one is a 404, not index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /dsp/* {
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /fonts/* {
		header Cache-Control "public, max-age=604800"
		file_server
	}
	@static path /favicon.* /robots.txt
	handle @static {
		file_server
	}

	# Everything else is the single-page app. The page itself is revalidated on each visit.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
