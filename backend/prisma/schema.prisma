generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChannelKind {
  BRANCH
  DISCUSSION
}

enum AudioFormat {
  OPUS
  MP3
  FLAC
  WAV
  OGG
  M4A
  AAC
}

// A User row is never hard-deleted — messages must stay attributed. isGhost
// marks an account that can't log in; ghostReason says why, since a
// Discord-import placeholder and a real member who deleted their account
// are both "ghosts" for attribution purposes but need different handling
// in the admin panel (only DISCORD_IMPORT is claimable).
enum GhostReason {
  DISCORD_IMPORT
  ACCOUNT_DELETED
}

model User {
  id                    Int          @id @default(autoincrement())
  username              String       @unique // kept forever, even for ghosts — attribution needs a name
  email                 String?      @unique // null once a ghost: no login, no PII to leak
  passwordHash          String?      // null for any ghost (Discord-import never had one; deleted accounts have it cleared)
  avatarUrl             String?
  bio                   String?
  links                 Json?
  isAdmin               Boolean      @default(false)
  isGhost               Boolean      @default(false)
  ghostReason           GhostReason?
  claimToken            String?      @unique // only ever set for DISCORD_IMPORT ghosts
  discordId             String?      @unique // Discord snowflake, for idempotent re-import and any future bot bridge
  linkedUserId          Int?         // ghost's discordId is linked to this real account — resolved at read time everywhere (messages, mentions, export), not a one-time reassignment, since a future bot bridge needs this mapping to keep working for new messages too
  linkedUser            User?        @relation("GhostLink", fields: [linkedUserId], references: [id])
  linkedGhosts          User[]       @relation("GhostLink")
  collaboratorProfile   Collaborator?
  deletedAt             DateTime? // set when a real account is ghosted (self- or admin-deleted)
  storageUsedBytes      BigInt       @default(0)
  storageLimitBytes     BigInt       @default(524288000) // 500MB — raised alongside the 100MB per-attachment limit, since local storage is meant to be temporary now (see the Storage admin tool)
  volumeNotifications   Float        @default(0.8)
  volumeSfxIdle         Float        @default(0.8) // SFX volume when no music is playing
  volumeSfxPlaying      Float        @default(0.6) // SFX volume while music is playing — ducked so it doesn't compete
  volumeMusic           Float        @default(1.0)
  caEnabled             Boolean      @default(true)
  moireEnabled          Boolean      @default(false)
  exclusiveMediaPlayback Boolean     @default(true) // when on, starting any audio/video (main player or chat-embedded) pauses every other one playing
  notifyWeeklySummary   Boolean      @default(true)
  notifyDailySummary    Boolean      @default(false)
  notifyFollowedReplies Boolean      @default(true)
  notifyPrivateMessage  Boolean      @default(true)
  discordUsername             String?  // for the bot to DM — matched against the bot's shared-server member list, not a stored user ID
  discordUserId               String?  @unique // preferred over discordUsername — a direct fetch by snowflake ID, more reliable than searching guild members by name
  notifyDiscordWeeklySummary  Boolean  @default(false)
  notifyDiscordDailySummary   Boolean  @default(false)
  notifyDiscordFollowedReplies Boolean @default(false)
  notifyDiscordPrivateMessage Boolean  @default(false)
  notifyNews            Boolean      @default(true)
  notifyCallsForIdeas   Boolean      @default(true)
  notifyCallsForArtists Boolean      @default(true)
  createdAt             DateTime     @default(now())

  messages         Message[]
  reactions        Reaction[]
  attachments      Attachment[]
  bookmarks        Bookmark[]
  emojisUploaded   CustomEmoji[]
  sentPMs          PrivateMessage[] @relation("PMSender")
  receivedPMs      PrivateMessage[] @relation("PMRecipient")
  followedChannels ChannelFollow[]
  newsletterSub    NewsletterSubscription?
  auditLogEntries  AuditLog[]
  wikiEdits        WikiPage[]       @relation("WikiEditor")
  blogPosts        BlogPost[]
  reviewedJoins    JoinRequest[]    @relation("JoinReviewer")
  soundPrefs       UserSoundPref[]
  notifications    Notification[]
}

model JoinRequest {
  id           Int               @id @default(autoincrement())
  username     String
  email        String
  passwordHash String
  avatarUrl    String?
  bio          String?
  links        Json?
  reason       String
  status       JoinRequestStatus @default(PENDING)
  reviewedById Int?
  reviewedBy   User?             @relation("JoinReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime          @default(now())
}

enum BranchVisibility {
  VISIBLE
  HIDDEN
  BABY_CRYSTALS
}

model Branch {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  description String?
  coverArtUrl String?
  hidden      Boolean  @default(false) // soft take-down: excluded from public listings, data untouched
  visibility  BranchVisibility @default(VISIBLE) // supersedes `hidden` — kept alongside it rather than migrated destructively; see deploy notes for the backfill
  crystalCount Int @default(5) // number of shard fragments rendered for a Baby Crystals branch, admin-controlled to reflect project progress
  isAnchor    Boolean  @default(false) // true + no parent = independent anchor elsewhere on the map, not part of the central cluster
  guideAssetId  Int?
  guideAsset    GuideAsset? @relation(fields: [guideAssetId], references: [id])
  voiceoverUrl  String? // audio played during the first-time intro
  voiceoverText String? @db.Text // text shown alongside the voiceover
  fontId      Int?
  font        CustomFont? @relation(fields: [fontId], references: [id])
  parentId    Int?
  parent      Branch?  @relation("BranchTree", fields: [parentId], references: [id])
  children    Branch[] @relation("BranchTree")
  posX        Float? // homepage tree layout hint
  posY        Float?
  createdAt   DateTime @default(now())

  channel ForumChannel?
  albums  Album[]
}

model ForumChannel {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  description String?
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  contentMarkdown String? @db.Text // optional illustrative content shown on the topic's page — images, text, embeds
  discordChannelId  String? @unique // the Discord channel this topic is bridged to
  discordWebhookUrl String? // optional — lets outgoing messages show as "{username} | Exo-API" instead of a plain bot message prefixed with the username
  category    String?
  position    Int         @default(0)
  kind        ChannelKind
  branchId    Int?        @unique // null for Discussion topics (not tied to a branch)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fontId      Int?
  font        CustomFont? @relation(fields: [fontId], references: [id])
  createdAt   DateTime    @default(now())

  messages Message[]
  mapNode  ForumMapNode?
  follows  ChannelFollow[]
}

model ChannelFollow {
  userId       Int
  channelId    Int
  user         User         @relation(fields: [userId], references: [id])
  channel      ForumChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  notifyOnReply Boolean     @default(true) // per-topic override under the global notifyFollowedReplies toggle
  createdAt    DateTime     @default(now())

  @@id([userId, channelId])
}

// id is a single global sequence shared by every forum message on the site,
// so any message is permanently addressable as /m/<id>. See ARCHITECTURE.md
// for the tradeoff this creates with the Discord importer.
model Message {
  id           Int          @id @default(autoincrement())
  channelId    Int
  channel      ForumChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId     Int
  author       User         @relation(fields: [authorId], references: [id])
  createdAt    DateTime     @default(now()) // source of truth; API exposes as unix seconds
  dayKey       DateTime     @db.Date // createdAt truncated to UTC date -> archive bucket
  replyToId    Int?
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReply")
  contentRaw   String       @db.Text
  isDeleted    Boolean      @default(false)
  editedAt     DateTime?
  importedFrom String? // e.g. "discord:<author-id>:<timestamp>" for traceability

  reactions   Reaction[]
  bookmarks   Bookmark[]
  attachments Attachment[]

  @@index([channelId, dayKey])
  @@index([channelId, createdAt])
  @@unique([channelId, importedFrom])
}

model Reaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  emojiId   Int
  emoji     CustomEmoji @relation(fields: [emojiId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emojiId])
}

model CustomEmoji {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  imageUrl        String
  uploadedById    Int?
  uploadedBy      User?    @relation(fields: [uploadedById], references: [id])
  isPaletteImport Boolean  @default(false)
  createdAt       DateTime @default(now())

  reactions Reaction[]
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
}

model Attachment {
  id               Int             @id @default(autoincrement())
  uploaderId       Int
  uploader         User            @relation(fields: [uploaderId], references: [id])
  messageId        Int?
  message          Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  privateMessageId Int?
  privateMessage   PrivateMessage? @relation(fields: [privateMessageId], references: [id], onDelete: Cascade)
  filename         String
  mimeType         String
  sizeBytes        BigInt
  storagePath      String
  createdAt        DateTime        @default(now())
}

model Album {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  slug        String   @unique
  title       String
  composer    String // default/primary composer shown on the album as a whole
  coverArtUrl String?
  description String?  @db.Text
  contentMarkdown String? @db.Text // optional illustrative content shown on the album's page — images, text, embeds
  createdAt   DateTime @default(now())

  tracks        Track[]
  collaborators AlbumCollaborator[]
  links         AlbumLink[]
  galleryImages AlbumGalleryImage[]
}

// Replaces the old fixed streamUrl/downloadUrl pair — named, unlimited,
// reorderable (Spotify, Bandcamp, archive.org, whatever else).
model LinkIcon {
  id  Int    @id @default(autoincrement())
  name String
  url  String
  albumLinks AlbumLink[]
  collaboratorLinks CollaboratorLink[]
}

model AlbumLink {
  id       Int    @id @default(autoincrement())
  albumId  Int
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  label    String
  url      String
  iconUrl  String? // legacy per-link upload — kept for anything set before the icon library existed
  linkIconId Int?
  linkIcon   LinkIcon? @relation(fields: [linkIconId], references: [id])
  position Int    @default(0)
}

model AlbumGalleryImage {
  id       Int    @id @default(autoincrement())
  albumId  Int
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url      String
  position Int    @default(0)
}

model Track {
  id              Int         @id @default(autoincrement())
  albumId         Int
  album           Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title           String
  fileUrl         String
  format          AudioFormat
  durationSeconds Int?
  position        Int         @default(0)

  bookmarks    AudioBookmark[]
  collaborators TrackCollaborator[] // per-track composer/credit override, checkbox-selected from the album's collaborators
}

// Multi-select ("checkboxes") credit per track — a track can have more than
// one composer when multiple collaborators worked on it specifically,
// distinct from Album.composer which is just the album-level default.
model TrackCollaborator {
  trackId        Int
  collaboratorId Int
  track          Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])

  @@id([trackId, collaboratorId])
}

model AudioBookmark {
  id               Int    @id @default(autoincrement())
  trackId          Int
  track            Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  label            String
  timestampSeconds Float
}

enum AboutFeatureKind {
  COLLABORATOR
  AWARD
  CUSTOM
}

// One ordered, admin-curated list powers the About page. A COLLABORATOR
// entry points at a Collaborator but carries its own description/image
// (independent of that collaborator's bio/pictureUrl used elsewhere, e.g.
// album credits) — the About page description doesn't have to match what
// shows on an album. AWARD and CUSTOM need no collaborator at all; this is
// the "awards, images with a description" extensibility asked for without
// another schema change when that's actually built.
model AboutFeature {
  id             Int              @id @default(autoincrement())
  kind           AboutFeatureKind @default(COLLABORATOR)
  collaboratorId Int?
  collaborator   Collaborator?    @relation(fields: [collaboratorId], references: [id])
  title          String? // required for AWARD/CUSTOM; optional override for COLLABORATOR
  description    String?          @db.Text
  imageUrl       String?
  position       Int              @default(0)
}

model Collaborator {
  id           Int     @id @default(autoincrement())
  slug         String? @unique
  name         String
  role         String
  position     Int     @default(0) // admin-controlled order for the all-collaborators wiki index
  bio          String? @db.Text
  pictureUrl   String?
  legacyLinksJson Json? // old unedited links blob — kept for the one-time migration script, no longer read by the app
  links        CollaboratorLink[]
  linkedUserId Int?    @unique
  linkedUser   User?   @relation(fields: [linkedUserId], references: [id])

  albums        AlbumCollaborator[]
  tracks        TrackCollaborator[]
  aboutFeatures AboutFeature[]
  galleryImages CollaboratorGalleryImage[]
}

model CollaboratorLink {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  label          String
  url            String
  linkIconId     Int?
  linkIcon       LinkIcon?    @relation(fields: [linkIconId], references: [id])
  position       Int          @default(0)
}

model CollaboratorGalleryImage {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  url            String
  position       Int          @default(0)
}

model AlbumCollaborator {
  albumId        Int
  collaboratorId Int
  album          Album        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])

  @@id([albumId, collaboratorId])
}

model WikiPage {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  parentId        Int?
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  parent          WikiPage?  @relation("WikiTree", fields: [parentId], references: [id])
  children        WikiPage[] @relation("WikiTree")
  title           String
  contentMarkdown String     @db.Text
  fontId          Int?
  font            CustomFont? @relation(fields: [fontId], references: [id])
  updatedById     Int
  updatedBy       User       @relation("WikiEditor", fields: [updatedById], references: [id])
  updatedAt       DateTime   @updatedAt

  siteSettings SiteSettings[]
}

model BlogPost {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  contentMarkdown String    @db.Text
  coverImageUrl   String?
  fontId          Int?
  font            CustomFont? @relation(fields: [fontId], references: [id])
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model NewsletterSubscription {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  userId           Int?     @unique
  user             User?    @relation(fields: [userId], references: [id])
  confirmed        Boolean  @default(false)
  subscribed       Boolean  @default(true) // admin can uncheck this without deleting the row or losing the email address
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
}

model PrivateMessage {
  id          Int       @id @default(autoincrement())
  senderId    Int
  sender      User      @relation("PMSender", fields: [senderId], references: [id])
  recipientId Int
  recipient   User      @relation("PMRecipient", fields: [recipientId], references: [id])
  contentRaw  String    @db.Text
  sentAt      DateTime  @default(now())
  readAt      DateTime?

  attachments Attachment[]
}

enum EmailType {
  WEEKLY_SUMMARY
  DAILY_SUMMARY
  TOPIC_REPLY
  PRIVATE_MESSAGE
  JOIN_APPROVED
  NEWS
  CALL_FOR_IDEAS
  CALL_FOR_ARTISTS
}

// Admin-editable HTML per email type. A missing row for a type just means
// "using the built-in default" (see lib/emailTemplates.ts) — this table
// only holds overrides, so shipping a new email type never requires a
// migration to backfill rows.
model EmailTemplate {
  type      EmailType @id
  subject   String
  bodyHtml  String    @db.Text
  updatedAt DateTime  @updatedAt
}

// Admin-uploaded fonts (OTF/TTF/WOFF/WOFF2), assignable per-branch,
// per-topic, per-wiki-page, or per-blog-post — each of those four gets its
// own optional fontId rather than one global "site font" choice.
// Admin-uploaded notification sounds, assignable as the default for any
// NotificationEvent and overridable per-user in account settings.
model NotificationSound {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  fileUrl   String
  format    String
  createdAt DateTime @default(now())

  defaultForEvents NotificationEvent[]
  userPrefs        UserSoundPref[]
}

// Admin can create as many of these as they want ("any number... for
// events") — key is what application code actually fires by; label is
// what the user sees in their preferences. Four are seeded (see seed.ts):
// message_followed_topic, message_other_topic, join_approved,
// account_updated — those four are the ones real code paths trigger today.
// Extra events an admin creates beyond those four are valid, storable, and
// selectable in preferences, but nothing fires them automatically yet —
// there's no code path wired to an arbitrary new key.
model NotificationEvent {
  id             Int                @id @default(autoincrement())
  key            String             @unique
  label          String
  defaultSoundId Int?
  defaultSound   NotificationSound? @relation(fields: [defaultSoundId], references: [id])

  userPrefs UserSoundPref[]
}

// Presence of a row = user has an override. soundId null on an existing
// row = explicitly muted. No row at all = "use the event's default sound".
model UserSoundPref {
  userId  Int
  eventId Int
  user    User               @relation(fields: [userId], references: [id])
  event   NotificationEvent  @relation(fields: [eventId], references: [id])
  soundId Int?
  sound   NotificationSound? @relation(fields: [soundId], references: [id])

  @@id([userId, eventId])
}

// Persistent per-user inbox — powers the notification widget (so it has
// history across reloads, not just whatever arrived while connected) and
// is what the personal WebSocket channel pushes as it's created.
model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  eventKey    String
  channelSlug String?
  messageId   Int?
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Singleton row (id is always 1) — sitewide settings that aren't tied to
// any specific branch/topic/wiki/blog. Currently just the default font
// applied everywhere nothing more specific overrides it.
// Admin-uploaded GIFs for the guide-character intro sequence (an "Aurora"-
// style animated guide). A library, not a single asset, since admin may
// want different guide animations to choose from per branch or in general.
model GuideAsset {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  gifUrl    String
  createdAt DateTime @default(now())

  branches Branch[]
}

model SiteSettings {
  id             Int         @id @default(1)
  defaultFontId  Int?
  defaultFont    CustomFont? @relation(fields: [defaultFontId], references: [id])
  forumMapInitialX    Float @default(0)
  forumMapInitialY    Float @default(0)
  forumMapInitialZoom Float @default(1)
  forumMapNavSpeed    Float @default(1) // multiplier on WASD/joystick acceleration — independent of zoom level
  ambienceUrl    String? // idle-landing ambient loop, plays when nothing else is
  scanSfxUrl     String? // spacemap text-reveal loop (branch lock-on + F/E/T hint)
  defaultWikiPageId Int?
  defaultWikiPage   WikiPage? @relation(fields: [defaultWikiPageId], references: [id])
  textColorPrimary   String? // overrides --text site-wide
  textColorSecondary String? // overrides --text-dim site-wide
  chatTitleColor     String? // chat dock branch title specifically
  accentPrimaryColor String? // overrides --accent-forum (the actual orange used by buttons/links/header/icons) site-wide
  contentTextScaleDesktop Float @default(2.0) // Wiki/News/Forums/chat-toolbar-buttons text scale, desktop
  contentTextScaleMobile  Float @default(1.6) // same, mobile
  caInitial          Float  @default(0.15) // site-wide chromatic aberration, always-present subtle shift
  caBurst            Float  @default(0.6)  // site-wide chromatic aberration, peak shift during a burst
  moireImageUrl      String? // uploaded PNG pattern for the site-wide moiré effect
  moireOpacity       Float  @default(0.15)
  moireSize          Float  @default(1) // scale multiplier on the uploaded image's natural tile size
  moireOffsetMin     Float  @default(0) // px
  moireOffsetMax     Float  @default(20) // px
  moireOffsetSpeed   Float  @default(0.3) // cycles per second of the offset LFO
  moireWaveform      String @default("sine") // "sine" | "triangle"
  moireRotationSpeed Float  @default(0.1) // degrees per second, wraps at 360
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassword       String?
  smtpFrom           String?
  smtpFromName       String? // display name shown to recipients — without this, most email clients just show the address's own prefix
  chatOpenSfxUrl     String? // plays once whenever a new chat location (branch/topic) is opened
  joinNotifyEmail    String? // admin gets emailed here whenever a new join request comes in
  joinNotifyDiscordUsername String? // admin also gets DMed here, if the bridge bot shares a server with this Discord account
  joinNotifyDiscordUserId   String? // preferred over the username above — a direct, reliable lookup by snowflake ID
  linkClickSfxUrl    String? // plays whenever the user clicks any hyperlink, site-wide
  chatHudRevealRate  Float   @default(30) // ms per character for the letter-by-letter chat reveal
  chatHudSfxUrl      String? // loops during the reveal
  chatSplashMessages Json?   // string[] — admin-managed rotating hints, "Write a message..." is the fallback if empty
  categoryOrder      Json?   // string[] — admin-controlled forum topic category display order
  discordBotToken    String? // Discord bot token — the bridge is inactive if this is unset
  discordAnnounceChannelId String? // channel the bot posts admin-selected announcements to, as itself (Exo-API)
  discordAnnounceEvents    Json?   // string[] — which event types are enabled, e.g. ["join_applied","join_approved","news_published","calls_for_artists","calls_for_ideas"]
  faviconUrl         String? // site-wide favicon
  ogHomepageTitle       String?
  ogHomepageDescription String?
  ogHomepageImageUrl    String?
  ogBranchDefaultTitle       String?
  ogBranchDefaultDescription String?
  ogBranchDefaultImageUrl    String?
  ogAlbumDefaultTitle       String?
  ogAlbumDefaultDescription String?
  ogAlbumDefaultImageUrl    String?
  ogWikiDefaultTitle       String?
  ogWikiDefaultDescription String?
  ogWikiDefaultImageUrl    String?
  ogNewsDefaultTitle       String?
  ogNewsDefaultDescription String?
  ogNewsDefaultImageUrl    String?
  ogForumDefaultTitle       String?
  ogForumDefaultDescription String?
  ogForumDefaultImageUrl    String?
}

model FxSettings {
  id                 Int    @id @default(1)
  spacingMultiplier  Float  @default(1.3) // scales repulsion radius/strength and world spread — raised above 1.0 by default since the map was reported as too cluttered
  debrisCount        Int    @default(320)
  wardenSizeMin      Float  @default(24)
  wardenSizeMax      Float  @default(44)
  split              Float  @default(0.4)
  chaos              Float  @default(0.5)
  drift              Float  @default(0.38)
  lurk               Float  @default(0.45)
  bgBright           Float  @default(0.5)
  rmsBrightnessAmount Float @default(0.3) // how much audio RMS pushes background brightness above bgBright while playing — 0 disables the effect
  bgSat              Float  @default(0.5)
  bgContrast         Float  @default(0.5)
  vignette           Float  @default(0.5)
  wardenHue          Float  @default(0)
  trailAmt           Float  @default(0.4)
  wardenReveal       Float  @default(0.65)
  wardenHuskBright   Float  @default(0.3)
  wardenOrbBright    Float  @default(0.3)
  glowHue            Float  @default(280)
  glowSat            Float  @default(0.6)
  glowBright         Float  @default(0.45)
}


model CustomFont {
  id         Int      @id @default(autoincrement())
  name       String   @unique // display name shown in admin, e.g. "Anomaly Mono"
  familyName String   @unique // sanitized CSS font-family value, derived from name
  fileUrl    String
  format     String // "opentype" | "truetype" | "woff" | "woff2" — goes straight into the @font-face src
  createdAt  DateTime @default(now())

  branches     Branch[]
  channels     ForumChannel[]
  wikiPages    WikiPage[]
  blogPosts    BlogPost[]
  siteSettings SiteSettings[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // "message.delete", "branch.create", "join.approve", ...
  targetType String
  targetId   Int?
  meta       Json?
  createdAt  DateTime @default(now())
}

enum ForumMapNodeType {
  TOPIC
  ACTIVE_BRANCHES
  GROWING_SEEDS
}

model ForumMapNode {
  id        Int              @id @default(autoincrement())
  type      ForumMapNodeType @default(TOPIC)
  channelId Int?             @unique
  channel   ForumChannel?    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parentId  Int?
  parent    ForumMapNode?    @relation("MapTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ForumMapNode[]   @relation("MapTree")
  x         Float            @default(0)
  y         Float            @default(0)
  color     String? // admin override — falls back to a type-based default when unset
  size      Float?  // admin override for the node's radius — same fallback
}
