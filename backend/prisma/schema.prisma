generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChannelKind {
  BRANCH
  DISCUSSION
}

enum AudioFormat {
  OPUS
  MP3
  FLAC
  WAV
  OGG
  M4A
  AAC
}

// A User row is never hard-deleted - messages must stay attributed. isGhost
// marks an account that can't log in; ghostReason says why, since a
// Discord-import placeholder and a real member who deleted their account
// are both "ghosts" for attribution purposes but need different handling
// in the admin panel (only DISCORD_IMPORT is claimable).
enum GhostReason {
  DISCORD_IMPORT
  ACCOUNT_DELETED
}

model User {
  id                    Int          @id @default(autoincrement())
  username              String       @unique // kept forever, even for ghosts - attribution needs a name
  email                 String?      @unique // null once a ghost: no login, no PII to leak
  passwordHash          String?      // null for any ghost (Discord-import never had one; deleted accounts have it cleared)
  avatarUrl             String?
  contributorPointsEntries ContributorPointsEntry[]
  trackComments         TrackComment[]
  communityTrackComments CommunityTrackComment[]
  dialJson              Json?        // the chat dock's dial: pinned rooms, scenes, sleeping slots (follows the member across devices)
  pointsAwarded             ContributorPointsEntry[] @relation("PointsAwardedBy")
  bio                   String?
  links                 Json?
  isAdmin               Boolean      @default(false)
  isGhost               Boolean      @default(false)
  ghostReason           GhostReason?
  claimToken            String?      @unique // only ever set for DISCORD_IMPORT ghosts
  discordId             String?      @unique // Discord snowflake, for idempotent re-import and any future bot bridge
  linkedUserId          Int?         // ghost's discordId is linked to this real account - resolved at read time everywhere (messages, mentions, export), not a one-time reassignment, since a future bot bridge needs this mapping to keep working for new messages too
  linkedUser            User?        @relation("GhostLink", fields: [linkedUserId], references: [id])
  linkedGhosts          User[]       @relation("GhostLink")
  collaboratorProfile   Collaborator?
  deletedAt             DateTime? // set when a real account is ghosted (self- or admin-deleted)
  storageUsedBytes      BigInt       @default(0)
  storageLimitBytes     BigInt       @default(524288000) // 500MB - raised alongside the 100MB per-attachment limit, since local storage is meant to be temporary now (see the Storage admin tool)
  volumeNotifications   Float        @default(0.8)
  volumeSfxIdle         Float        @default(0.8) // SFX volume when no music is playing
  volumeSfxPlaying      Float        @default(0.6) // SFX volume while music is playing - ducked so it doesn't compete
  volumeMusic           Float        @default(1.0)
  caEnabled             Boolean      @default(false)
  moireEnabled          Boolean      @default(false)
  exclusiveMediaPlayback Boolean     @default(true) // when on, starting any audio/video (main player or chat-embedded) pauses every other one playing
  notifyWeeklySummary   Boolean      @default(true)
  notifyDailySummary    Boolean      @default(false)
  notifyFollowedReplies Boolean      @default(true)
  notifyPrivateMessage  Boolean      @default(true)
  discordUsername             String?  // for the bot to DM - matched against the bot's shared-server member list, not a stored user ID
  discordUserId               String?  @unique // preferred over discordUsername - a direct fetch by snowflake ID, more reliable than searching guild members by name
  notifyDiscordWeeklySummary  Boolean  @default(false)
  notifyDiscordDailySummary   Boolean  @default(false)
  notifyDiscordFollowedReplies Boolean @default(false)
  notifyDiscordPrivateMessage Boolean  @default(false)
  notifyNews            Boolean      @default(true)
  notifyCallsForIdeas   Boolean      @default(true)
  notifyCallsForArtists Boolean      @default(true)
  createdAt             DateTime     @default(now())

  messages         Message[]
  reactions        Reaction[]
  attachments      Attachment[]
  communityAlbums  CommunityAlbum[]
  playlists        Playlist[]
  communityTrackLikes CommunityTrackLike[]
  playlistCollaborations PlaylistCollaborator[]
  sampleBankItems SampleBankItem[]
  resourceUnlocks ResourceUnlock[]
  rewardClaims RewardClaim[]
  hypotheses   Hypothesis[]
  pollVotes    PollVote[]
  puzzleSolves PuzzleSolve[]
  lettersSent  Letter[]  @relation("LetterAuthor")
  lettersGot   Letter[]  @relation("LetterTo")
  letterBlocks LetterBlock[] @relation("Blocker")
  letterBlocked LetterBlock[] @relation("Blocked")
  trials       Trial[]
  studies         Study[]
  studyRevisions  StudyRevision[] @relation("StudyRevisionAuthor")
  challengeSubmissions ChallengeSubmission[]
  questionsAsked ForumChannel[]
  bookmarks        Bookmark[]
  emojisUploaded   CustomEmoji[]
  sentPMs          PrivateMessage[] @relation("PMSender")
  receivedPMs      PrivateMessage[] @relation("PMRecipient")
  welcomedBy       WelcomeBuddy?    @relation("WelcomeNew") // the member asked to greet this one
  welcoming        WelcomeBuddy[]   @relation("WelcomeBuddy") // newcomers this member was asked to greet
  followedChannels ChannelFollow[]
  newsletterSub    NewsletterSubscription?
  auditLogEntries  AuditLog[]
  wikiEdits        WikiPage[]       @relation("WikiEditor")
  blogPosts        BlogPost[]
  reviewedJoins    JoinRequest[]    @relation("JoinReviewer")
  soundPrefs       UserSoundPref[]
  notifications    Notification[]
}

model JoinRequest {
  id           Int               @id @default(autoincrement())
  username     String
  email        String
  passwordHash String
  avatarUrl    String?
  bio          String?
  links        Json?
  reason       String
  status       JoinRequestStatus @default(PENDING)
  reviewedById Int?
  reviewedBy   User?             @relation("JoinReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime          @default(now())
}

enum BranchVisibility {
  VISIBLE
  HIDDEN
  BABY_CRYSTALS
}

model Branch {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  description String?
  longDescription String? @db.Text // the second, longer description: shown when the branch is expanded in Soundbay (the short one is the row's)
  coverArtUrl String?
  hidden      Boolean  @default(false) // soft take-down: excluded from public listings, data untouched
  visibility  BranchVisibility @default(VISIBLE) // supersedes `hidden` - kept alongside it rather than migrated destructively; see deploy notes for the backfill
  crystalCount Int @default(5) // number of shard fragments rendered for a Baby Crystals branch, admin-controlled to reflect project progress
  isAnchor    Boolean  @default(false) // true + no parent = independent anchor elsewhere on the map, not part of the central cluster
  guideAssetId  Int?
  guideAsset    GuideAsset? @relation(fields: [guideAssetId], references: [id])
  voiceoverUrl  String? // audio played during the first-time intro
  voiceoverText String? @db.Text // text shown alongside the voiceover
  fontId      Int?
  font        CustomFont? @relation(fields: [fontId], references: [id])
  parentId    Int?
  parent      Branch?  @relation("BranchTree", fields: [parentId], references: [id])
  children    Branch[] @relation("BranchTree")
  posX        Float? // homepage tree layout hint
  posY        Float?
  createdAt   DateTime @default(now())

  wanted BranchWanted[]
  radioBlocks RadioBlock[]
  briefMarkdown       String?     @db.Text // admin-authored concept brief for contributors, shown on "Choose your next project"
  contributeBackgroundUrl     String?
  contributeBackgroundOpacity Float   @default(0.3)
  identityColor       String?     // admin-chosen accent colour, #rrggbb: gives the branch a recognisable look in lists and on the map
  identityGlyph       String?     // admin-chosen emblem, one of a fixed set (see lib/branchIdentity.ts)
  identityImageUrl    String?     // the branch's MAIN image: shown in place of the emblem (an album cover or gallery picture, or an upload)
  identitySecondaryImageUrl String? // the branch's SECONDARY image: the soft background of its tile and of the homepage module when it is chosen
  reactionEmojiIds    Int[]       @default([]) // the emoji this branch's chat offers first when reacting (its own reaction culture)
  identityBgOpacity   Float?      // how strongly the branch's images show as backgrounds (0.05 - 0.9). null = each place's own soft default
  previewAttachmentId Int?        @unique
  sampleTrackId       Int?        // a track already on the site, offered as the branch's sample (instead of a chat file)
  sampleTrack         Track?      @relation("BranchSampleTrack", fields: [sampleTrackId], references: [id], onDelete: SetNull)
  sampleCommunityTrackId Int?
  sampleCommunityTrack   CommunityTrack? @relation("BranchSampleCommunityTrack", fields: [sampleCommunityTrackId], references: [id], onDelete: SetNull)
  previewAttachment   Attachment? @relation("BranchPreview", fields: [previewAttachmentId], references: [id])
  sketches            BranchSketch[]
  submissions         CommunityAlbum[] @relation("BranchSubmissions")

  channel ForumChannel?
  albums  Album[]
  studies Study[] @relation("StudyBranches") // studies connected to this branch (shown in its Explore module and expanded in Soundbay)
}

// Admin-curated chat attachments ("selected experiments") a contributor
// can download as inspiration/source material for a branch - the admin
// picks from what's already been shared in that branch's discussion,
// nothing new to upload.
model BranchSketch {
  id           Int        @id @default(autoincrement())
  branchId     Int
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  attachmentId Int        @unique
  attachment   Attachment @relation("BranchSketchAttachment", fields: [attachmentId], references: [id])
  addedAt      DateTime   @default(now())
  tracks       Track[]    @relation("TrackFromSketch")
}

model ForumChannel {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  description String?
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  contentMarkdown String? @db.Text // optional illustrative content shown on the topic's page - images, text, embeds
  discordChannelId  String? @unique // the Discord channel this topic is bridged to
  discordWebhookUrl String? // optional - lets outgoing messages show as "{username} | Exo-API" instead of a plain bot message prefixed with the username
  category    String?
  position    Int         @default(0)
  kind        ChannelKind
  branchId    Int?        @unique // null for Discussion topics (not tied to a branch)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isUserQuestion Boolean  @default(false) // true for a "Your Questions" thread a user created themselves
  askedById   Int?
  askedBy     User?       @relation(fields: [askedById], references: [id], onDelete: SetNull)
  fontId      Int?
  font        CustomFont? @relation(fields: [fontId], references: [id])
  createdAt   DateTime    @default(now())

  messages Message[]
  mapNode  ForumMapNode?
  follows  ChannelFollow[]
  studies  Study[]
  submissionFor CommunityAlbum?
}

model ChannelFollow {
  userId       Int
  channelId    Int
  user         User         @relation(fields: [userId], references: [id])
  channel      ForumChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  notifyOnReply Boolean     @default(true) // per-topic override under the global notifyFollowedReplies toggle
  createdAt    DateTime     @default(now())

  @@id([userId, channelId])
}

// id is a single global sequence shared by every forum message on the site,
// so any message is permanently addressable as /m/<id>. See ARCHITECTURE.md
// for the tradeoff this creates with the Discord importer.
model Message {
  id           Int          @id @default(autoincrement())
  channelId    Int
  channel      ForumChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId     Int
  author       User         @relation(fields: [authorId], references: [id])
  createdAt    DateTime     @default(now()) // source of truth; API exposes as unix seconds
  dayKey       DateTime     @db.Date // createdAt truncated to UTC date -> archive bucket
  replyToId    Int?
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReply")
  contentRaw   String       @db.Text
  isDeleted    Boolean      @default(false)
  deletedAt    DateTime? // set while the message sits in the 30-day trash (restorable); cleared when its files are purged
  editedAt     DateTime?
  importedFrom String? // e.g. "discord:<author-id>:<timestamp>" for traceability
  discordMessageId String? @unique // set once forwarded to Discord - lets a Discord-side reply resolve back to this message
  kind         String       @default("text") // text | cq | report | poll | ab | clip. contentRaw always holds a plain-text version, so Discord, search and exports keep working
  data         Json?        // the structured part of a non-text message, rebuilt server-side from known fields
  pollVotes    PollVote[]

  reactions   Reaction[]
  bookmarks   Bookmark[]
  attachments Attachment[]

  @@index([channelId, dayKey])
  @@index([channelId, createdAt])
  @@index([deletedAt])
  @@unique([channelId, importedFrom])
}

model Reaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  emojiId   Int
  emoji     CustomEmoji @relation(fields: [emojiId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emojiId])
}

model CustomEmoji {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  imageUrl        String
  uploadedById    Int?
  uploadedBy      User?    @relation(fields: [uploadedById], references: [id])
  isPaletteImport Boolean  @default(false)
  createdAt       DateTime @default(now())

  reactions Reaction[]
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
}

model Attachment {
  id               Int             @id @default(autoincrement())
  uploaderId       Int
  uploader         User            @relation(fields: [uploaderId], references: [id])
  messageId        Int?
  message          Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  privateMessageId Int?
  privateMessage   PrivateMessage? @relation(fields: [privateMessageId], references: [id], onDelete: Cascade)
  filename         String
  mimeType         String
  sizeBytes        BigInt
  storagePath      String
  createdAt        DateTime        @default(now())
  communityTrack   CommunityTrack?
  sampleBankItem   SampleBankItem?
  communityAlbumCover CommunityAlbum?
  branchPreviewFor    Branch?       @relation("BranchPreview")
  branchSketchFor     BranchSketch? @relation("BranchSketchAttachment")
  chartSources        StudyChart[]  @relation("ChartSource")
  trackRevisions      CommunityTrackRevision[]
  // Set for files uploaded into a study (audio recordings, spectrograms). Lets the study find - and clean
  // up - exactly its own files. SetNull rather than Cascade so that if a study is ever removed some other
  // way, the rows survive for the admin storage tools instead of silently orphaning files on disk.
  studyId             Int?
  study               Study?        @relation("StudyFiles", fields: [studyId], references: [id], onDelete: SetNull)

  @@index([studyId])
}

model Album {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  slug        String   @unique
  title       String
  composer    String // default/primary composer shown on the album as a whole
  coverArtUrl String?
  description String?  @db.Text
  contentMarkdown String? @db.Text // optional illustrative content shown on the album's page - images, text, embeds
  transition  String   @default("none") // how the album's tracks join in the player: "none" | "gapless" | "crossfade" (set by the album's author)
  crossfadeMs Int      @default(3000)   // overlap for "crossfade"
  createdAt   DateTime @default(now())

  tracks        Track[]
  collaborators AlbumCollaborator[]
  links         AlbumLink[]
  galleryImages AlbumGalleryImage[]
}

// Replaces the old fixed streamUrl/downloadUrl pair - named, unlimited,
// reorderable (Spotify, Bandcamp, archive.org, whatever else).
model LinkIcon {
  id  Int    @id @default(autoincrement())
  name String
  url  String
  albumLinks AlbumLink[]
  collaboratorLinks CollaboratorLink[]
}

model AlbumLink {
  id       Int    @id @default(autoincrement())
  albumId  Int
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  label    String
  url      String
  iconUrl  String? // legacy per-link upload - kept for anything set before the icon library existed
  linkIconId Int?
  linkIcon   LinkIcon? @relation(fields: [linkIconId], references: [id])
  position Int    @default(0)
}

model AlbumGalleryImage {
  id       Int    @id @default(autoincrement())
  albumId  Int
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url      String
  position Int    @default(0)
}

model Track {
  id              Int         @id @default(autoincrement())
  albumId         Int
  album           Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title           String
  fileUrl         String
  format          AudioFormat
  durationSeconds Int?
  position        Int         @default(0)
  replayGainDb    Float? @map("replay_gain_db_v2") // sitewide loudness normalization (target -11 LUFS, boost limited by peak) - null means not yet analyzed. The column name changed with the target so every track is measured afresh.
  genres          String[] @default([]) // user-assigned, as many as wanted - drives Venn Views placement
  lyrics          String?  @db.Text // also doubles as the constellation scan panel's logbook description
  fromStudyId     Int?     // provenance: the study this piece came out of
  fromStudy       Study?   @relation("TrackFromStudy", fields: [fromStudyId], references: [id], onDelete: SetNull)
  fromSketchId    Int?     // provenance: the branch sketch it grew from
  fromSketch      BranchSketch? @relation("TrackFromSketch", fields: [fromSketchId], references: [id], onDelete: SetNull)

  bookmarks    AudioBookmark[]
  comments     TrackComment[]
  collaborators TrackCollaborator[] // per-track composer/credit override, checkbox-selected from the album's collaborators
  playlistItems PlaylistItem[]
  sampleForBranches Branch[] @relation("BranchSampleTrack")
  phenomena    Phenomenon[] @relation("PhenomenonExample")
}

// Multi-select ("checkboxes") credit per track - a track can have more than
// one composer when multiple collaborators worked on it specifically,
// distinct from Album.composer which is just the album-level default.
model TrackCollaborator {
  trackId        Int
  collaboratorId Int
  track          Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])
  roles          String[]     @default([]) // what they did on this track (see lib/creditRoles); empty = composer

  @@id([trackId, collaboratorId])
}

// A short note pinned to a moment in a track, written on the player's spectrogram strip.
model TrackComment {
  id        Int      @id @default(autoincrement())
  trackId   Int
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  atSeconds Float
  endSeconds Float? // set when the note covers a stretch (a region) instead of a moment
  body      String
  createdAt DateTime @default(now())

  @@index([trackId, atSeconds])
}

model CommunityTrackComment {
  answeredBy CommunityTrackRevision[]
  id        Int            @id @default(autoincrement())
  trackId   Int
  track     CommunityTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  atSeconds Float
  endSeconds Float?
  body      String
  createdAt DateTime       @default(now())

  @@index([trackId, atSeconds])
}

model AudioBookmark {
  id               Int    @id @default(autoincrement())
  trackId          Int
  track            Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  label            String
  timestampSeconds Float
}

enum AboutFeatureKind {
  COLLABORATOR
  AWARD
  CUSTOM
}

// One ordered, admin-curated list powers the About page. A COLLABORATOR
// entry points at a Collaborator but carries its own description/image
// (independent of that collaborator's bio/pictureUrl used elsewhere, e.g.
// album credits) - the About page description doesn't have to match what
// shows on an album. AWARD and CUSTOM need no collaborator at all; this is
// the "awards, images with a description" extensibility asked for without
// another schema change when that's actually built.
model AboutFeature {
  id             Int              @id @default(autoincrement())
  kind           AboutFeatureKind @default(COLLABORATOR)
  collaboratorId Int?
  collaborator   Collaborator?    @relation(fields: [collaboratorId], references: [id])
  title          String? // required for AWARD/CUSTOM; optional override for COLLABORATOR
  description    String?          @db.Text
  imageUrl       String?
  position       Int              @default(0)
}

model Collaborator {
  id           Int     @id @default(autoincrement())
  slug         String? @unique
  name         String
  role         String
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  position     Int     @default(0) // admin-controlled order for the all-collaborators wiki index
  bio          String? @db.Text
  pictureUrl   String?
  legacyLinksJson Json? // old unedited links blob - kept for the one-time migration script, no longer read by the app
  links        CollaboratorLink[]
  linkedUserId Int?    @unique
  linkedUser   User?   @relation(fields: [linkedUserId], references: [id])

  albums        AlbumCollaborator[]
  tracks        TrackCollaborator[]
  aboutFeatures AboutFeature[]
  galleryImages CollaboratorGalleryImage[]
}

model CollaboratorLink {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  label          String
  url            String
  linkIconId     Int?
  linkIcon       LinkIcon?    @relation(fields: [linkIconId], references: [id])
  position       Int          @default(0)
}

model CollaboratorGalleryImage {
  id             Int          @id @default(autoincrement())
  collaboratorId Int
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  url            String
  position       Int          @default(0)
}

model AlbumCollaborator {
  albumId        Int
  collaboratorId Int
  album          Album        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id])

  @@id([albumId, collaboratorId])
}

model WikiPage {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  parentId        Int?
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  parent          WikiPage?  @relation("WikiTree", fields: [parentId], references: [id])
  children        WikiPage[] @relation("WikiTree")
  title           String
  contentMarkdown String     @db.Text
  fontId          Int?
  font            CustomFont? @relation(fields: [fontId], references: [id])
  updatedById     Int
  updatedBy       User       @relation("WikiEditor", fields: [updatedById], references: [id])
  updatedAt       DateTime   @updatedAt

  siteSettings SiteSettings[]
}

model BlogPost {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  title           String
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  contentMarkdown String    @db.Text
  coverImageUrl   String?
  fontId          Int?
  font            CustomFont? @relation(fields: [fontId], references: [id])
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model NewsletterSubscription {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  userId           Int?     @unique
  user             User?    @relation(fields: [userId], references: [id])
  confirmed        Boolean  @default(false)
  subscribed       Boolean  @default(true) // admin can uncheck this without deleting the row or losing the email address
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
}

model PrivateMessage {
  id          Int       @id @default(autoincrement())
  senderId    Int
  sender      User      @relation("PMSender", fields: [senderId], references: [id])
  recipientId Int
  recipient   User      @relation("PMRecipient", fields: [recipientId], references: [id])
  contentRaw  String    @db.Text
  sentAt      DateTime  @default(now())
  readAt      DateTime?

  attachments Attachment[]
}

enum EmailType {
  WEEKLY_SUMMARY
  DAILY_SUMMARY
  TOPIC_REPLY
  PRIVATE_MESSAGE
  JOIN_APPROVED
  NEWS
  CALL_FOR_IDEAS
  CALL_FOR_ARTISTS
  WELCOME_BUDDY
}

// Admin-editable HTML per email type. A missing row for a type just means
// "using the built-in default" (see lib/emailTemplates.ts) - this table
// only holds overrides, so shipping a new email type never requires a
// migration to backfill rows.
model EmailTemplate {
  type      EmailType @id
  subject   String
  bodyHtml  String    @db.Text
  updatedAt DateTime  @updatedAt
}

// Admin-uploaded fonts (OTF/TTF/WOFF/WOFF2), assignable per-branch,
// per-topic, per-wiki-page, or per-blog-post - each of those four gets its
// own optional fontId rather than one global "site font" choice.
// Admin-uploaded notification sounds, assignable as the default for any
// NotificationEvent and overridable per-user in account settings.
model NotificationSound {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  fileUrl   String
  format    String
  createdAt DateTime @default(now())

  defaultForEvents NotificationEvent[]
  userPrefs        UserSoundPref[]
}

// Admin can create as many of these as they want ("any number... for
// events") - key is what application code actually fires by; label is
// what the user sees in their preferences. Four are seeded (see seed.ts):
// message_followed_topic, message_other_topic, join_approved,
// account_updated - those four are the ones real code paths trigger today.
// Extra events an admin creates beyond those four are valid, storable, and
// selectable in preferences, but nothing fires them automatically yet -
// there's no code path wired to an arbitrary new key.
model NotificationEvent {
  id             Int                @id @default(autoincrement())
  key            String             @unique
  label          String
  defaultSoundId Int?
  defaultSound   NotificationSound? @relation(fields: [defaultSoundId], references: [id])

  userPrefs UserSoundPref[]
}

// Presence of a row = user has an override. soundId null on an existing
// row = explicitly muted. No row at all = "use the event's default sound".
model UserSoundPref {
  userId  Int
  eventId Int
  user    User               @relation(fields: [userId], references: [id])
  event   NotificationEvent  @relation(fields: [eventId], references: [id])
  soundId Int?
  sound   NotificationSound? @relation(fields: [soundId], references: [id])

  @@id([userId, eventId])
}

// Persistent per-user inbox - powers the notification widget (so it has
// history across reloads, not just whatever arrived while connected) and
// is what the personal WebSocket channel pushes as it's created.
model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  eventKey    String
  channelSlug String?
  messageId   Int?
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Singleton row (id is always 1) - sitewide settings that aren't tied to
// any specific branch/topic/wiki/blog. Currently just the default font
// applied everywhere nothing more specific overrides it.
// Admin-uploaded GIFs for the guide-character intro sequence (an "Aurora"-
// style animated guide). A library, not a single asset, since admin may
// want different guide animations to choose from per branch or in general.
model GuideAsset {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  gifUrl    String
  createdAt DateTime @default(now())

  branches Branch[]
}

model SiteSettings {
  id             Int         @id @default(1)
  defaultFontId  Int?
  defaultFont    CustomFont? @relation(fields: [defaultFontId], references: [id])
  forumMapInitialX    Float @default(0)
  forumMapInitialY    Float @default(0)
  forumMapInitialZoom Float @default(1)
  forumMapNavSpeed    Float @default(1) // multiplier on WASD/joystick acceleration - independent of zoom level
  forumMapFireflySize Float @default(1) // multiplier on each firefly's rendered size
  forumMapFireflySpeed Float @default(1) // multiplier on the fireflies' orbit speed
  spotlightCommunityTrackId Int? // admin-curated "featured this week" pick, shown at the top of /community
  cultActivitiesChannelId Int? // the general chat channel shown on the Cult Activities page
  ambienceUrl    String? // idle-landing ambient loop, plays when nothing else is
  scanSfxUrl     String? // spacemap text-reveal loop (branch lock-on + F/E/T hint)
  defaultWikiPageId Int?
  defaultWikiPage   WikiPage? @relation(fields: [defaultWikiPageId], references: [id])
  playHighlightColor String? // glow + drifting firefly on the Play buttons visitors should reach for; null = icy blue (#8fd8ff, the default); "off" = no highlight
  usernameColor      String? // the colour every username is shown in outside chat (and the link to their page)
  visorColor         String? // the Scan Visor's main colour, #rrggbb (null = the default cyan)
  visorMineColor     String? // the colour of your own notes in the Scan Visor (null = the default amber)
  textColorPrimary   String? // overrides --text site-wide
  textColorSecondary String? // overrides --text-dim site-wide
  chatTitleColor     String? // chat dock branch title specifically
  accentPrimaryColor String? // overrides --accent-forum (the actual orange used by buttons/links/header/icons) site-wide
  contentTextScaleDesktop Float @default(2.0) // Wiki/News/Forums/chat-toolbar-buttons text scale, desktop
  contentTextScaleMobile  Float @default(1.6) // same, mobile
  caInitial          Float  @default(0.15) // site-wide chromatic aberration, always-present subtle shift
  caBurst            Float  @default(0.6)  // site-wide chromatic aberration, peak shift during a burst
  moireImageUrl      String? // uploaded PNG pattern for the site-wide moiré effect
  moireOpacity       Float  @default(0.15)
  moireSize          Float  @default(1) // scale multiplier on the uploaded image's natural tile size
  moireOffsetMin     Float  @default(0) // px
  moireOffsetMax     Float  @default(20) // px
  moireOffsetSpeed   Float  @default(0.3) // cycles per second of the offset LFO
  moireWaveform      String @default("sine") // "sine" | "triangle"
  moireRotationSpeed Float  @default(0.1) // degrees per second, wraps at 360
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassword       String?
  smtpFrom           String?
  smtpFromName       String? // display name shown to recipients - without this, most email clients just show the address's own prefix
  chatOpenSfxUrl     String? // plays once whenever a new chat location (branch/topic) is opened
  joinNotifyEmail    String? // admin gets emailed here whenever a new join request comes in
  joinNotifyDiscordUsername String? // admin also gets DMed here, if the bridge bot shares a server with this Discord account
  joinNotifyDiscordUserId   String? // preferred over the username above - a direct, reliable lookup by snowflake ID
  linkClickSfxUrl    String? // plays whenever the user clicks any hyperlink, site-wide
  chatHudRevealRate  Float   @default(30) // ms per character for the letter-by-letter chat reveal
  chatHudSfxUrl      String? // loops during the reveal
  chatSplashMessages Json?   // string[] - admin-managed rotating hints, "Write a message..." is the fallback if empty
  categoryOrder      Json?   // string[] - admin-controlled forum topic category display order
  discordBotToken    String? // Discord bot token - the bridge is inactive if this is unset
  discordAnnounceChannelId String? // channel the bot posts admin-selected announcements to, as itself (Exo-API)
  discordPresenceChannelId String? // if set, only guild members who can see this channel count toward online presence; if unset, all online guild members do
  discordAnnounceEvents    Json?   // string[] - which event types are enabled, e.g. ["join_applied","join_approved","news_published","calls_for_artists","calls_for_ideas"]
  faviconUrl         String? // site-wide favicon
  ogHomepageTitle       String?
  ogHomepageDescription String?
  ogHomepageImageUrl    String?
  ogBranchDefaultTitle       String?
  ogBranchDefaultDescription String?
  ogBranchDefaultImageUrl    String?
  ogAlbumDefaultTitle       String?
  ogAlbumDefaultDescription String?
  ogAlbumDefaultImageUrl    String?
  ogWikiDefaultTitle       String?
  ogWikiDefaultDescription String?
  ogWikiDefaultImageUrl    String?
  ogNewsDefaultTitle       String?
  ogNewsDefaultDescription String?
  ogNewsDefaultImageUrl    String?
  ogForumDefaultTitle       String?
  ogForumDefaultDescription String?
  ogForumDefaultImageUrl    String?
  ogCollaboratorDefaultTitle       String?
  ogCollaboratorDefaultDescription String?
  ogCollaboratorDefaultImageUrl    String?
  ogForumsIndexTitle       String? // shared by both /discussion (list) and /discussion/map - one embed for the whole Forums section
  ogForumsIndexDescription String?
  ogForumsIndexImageUrl    String?
}

model FxSettings {
  id                 Int    @id @default(1)
  spacingMultiplier  Float  @default(1.3) // scales repulsion radius/strength and world spread - raised above 1.0 by default since the map was reported as too cluttered
  debrisCount        Int    @default(320)
  wardenSizeMin      Float  @default(24)
  wardenSizeMax      Float  @default(44)
  split              Float  @default(0.4)
  chaos              Float  @default(0.5)
  drift              Float  @default(0.38)
  lurk               Float  @default(0.45)
  bgBright           Float  @default(0.5)
  rmsBrightnessAmount Float @default(0.3) // how much audio RMS pushes background brightness above bgBright while playing - 0 disables the effect
  bgSat              Float  @default(0.5)
  bgContrast         Float  @default(0.5)
  vignette           Float  @default(0.5)
  wardenHue          Float  @default(0)
  trailAmt           Float  @default(0.4)
  wardenReveal       Float  @default(0.65)
  wardenHuskBright   Float  @default(0.3)
  wardenOrbBright    Float  @default(0.3)
  glowHue            Float  @default(280)
  glowSat            Float  @default(0.6)
  glowBright         Float  @default(0.45)
}


model CustomFont {
  id         Int      @id @default(autoincrement())
  name       String   @unique // display name shown in admin, e.g. "Anomaly Mono"
  familyName String   @unique // sanitized CSS font-family value, derived from name
  fileUrl    String
  format     String // "opentype" | "truetype" | "woff" | "woff2" - goes straight into the @font-face src
  createdAt  DateTime @default(now())

  branches     Branch[]
  channels     ForumChannel[]
  wikiPages    WikiPage[]
  blogPosts    BlogPost[]
  siteSettings SiteSettings[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // "message.delete", "branch.create", "join.approve", ...
  targetType String
  targetId   Int?
  meta       Json?
  createdAt  DateTime @default(now())
}

enum StudyStatus {
  IN_PROGRESS
  COMPLETE
}

// A researcher's documented phenomenon/experiment - lighter-weight than
// the Wiki, with a real lifecycle (in-progress vs complete) the Wiki's
// plain published/unpublished model doesn't have. Annotations are
// author-authored and author-editable only, rendered as a numbered
// endnotes list the author references from the body as plain [1] [2]
// text - not a live-linked or reader-editable citation system.
model Study {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  ownerId     Int
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  body        String            @db.Text
  status      StudyStatus       @default(IN_PROGRESS)
  backgroundUrl String?         // the picture behind the study's card and page: a link, an upload, or one of its branches' images
  backgroundOpacity Float?      // how strongly that picture shows (0.05 - 0.9); null = the soft default
  ogTitle       String?         // embed / SEO overrides (blank = the study's own title and first words)
  ogDescription String?
  ogImageUrl    String?
  channelId   Int?              // the study's discussion chat: its own auto-created one, or any existing branch/topic chat the owner picked. Several studies may share one chat.
  channel     ForumChannel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  annotations StudyAnnotation[]
  mapNode     ForumMapNode?
  charts      StudyChart[]
  revisions   StudyRevision[]
  files       Attachment[]      @relation("StudyFiles")
  branches    Branch[]          @relation("StudyBranches") // none, one or several
  hypotheses  Hypothesis[]
  tracksMade  Track[]           @relation("TrackFromStudy")
}

// A snapshot of a study's title and body taken on save, so earlier drafts
// of a paper can be compared and restored. Saves by the same author within
// a couple of minutes are folded into one snapshot (see studyRevisionRules).
model StudyRevision {
  id        Int      @id @default(autoincrement())
  studyId   Int
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  authorId  Int?
  author    User?    @relation("StudyRevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  body      String   @db.Text
  label     String? // "Original", "Restored from ..." - labelled snapshots are never folded into or pruned
  createdAt DateTime @default(now())

  @@index([studyId, createdAt])
}

enum StudyChartKind {
  LINE
  BAR
  SCATTER
  TABLE
}

// Data blocks a researcher embeds in a study - CSV text (first row is
// headers) rather than a structured JSON shape, since that's the
// simplest possible input for a scientist to paste from a spreadsheet
// or type by hand, with no special editor needed.
model StudyChart {
  id       Int            @id @default(autoincrement())
  studyId  Int
  study    Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  position Int
  title    String
  kind     StudyChartKind @default(LINE)
  xLabel   String?
  yLabel   String?
  xLog     Boolean        @default(false) // logarithmic axes, e.g. frequency in Hz
  yLog     Boolean        @default(false)
  dataCsv  String         @db.Text // the data (or, when sourceFile is set, the last copy of it)
  sourceFileId Int?        // live data: a CSV among the study's files, re-read each time the study is opened
  sourceFile   Attachment? @relation("ChartSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
}

model StudyAnnotation {
  id       Int    @id @default(autoincrement())
  studyId  Int
  study    Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)
  position Int // the [1] [2] [3] numbering, author-reordered by drag or up/down
  text     String @db.Text
}

enum ForumMapNodeType {
  TOPIC
  ACTIVE_BRANCHES
  GROWING_SEEDS
  PLAYLIST
  SAMPLE_BANK_ITEM
  CHALLENGE
  STUDY
}

model ForumMapNode {
  id        Int              @id @default(autoincrement())
  type      ForumMapNodeType @default(TOPIC)
  channelId Int?             @unique
  channel   ForumChannel?    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  playlistId Int?            @unique
  playlist   Playlist?       @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  sampleBankItemId Int?      @unique
  sampleBankItem   SampleBankItem? @relation(fields: [sampleBankItemId], references: [id], onDelete: Cascade)
  challengeId Int?           @unique
  challenge   Challenge?     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  studyId Int?               @unique
  study   Study?             @relation(fields: [studyId], references: [id], onDelete: Cascade)
  parentId  Int?
  parent    ForumMapNode?    @relation("MapTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ForumMapNode[]   @relation("MapTree")
  x         Float            @default(0)
  y         Float            @default(0)
  color     String? // admin override - falls back to a type-based default when unset
  size      Float?  // admin override for the node's radius - same fallback
  hidden    Boolean @default(false) // hidden by default - parent shows a reveal handle instead, until the visitor interacts with it
}

// --- Sample/patch bank: raw material separate from finished tracks -
// field recordings, synth presets, alterant scripts, one-shots. A flat,
// tagged library rather than albums, since there's no natural "release"
// structure for this kind of material.

enum SampleKind {
  AUDIO
  PATCH
  SCRIPT
  OTHER
}

model SampleBankItem {
  id           Int        @id @default(autoincrement())
  ownerId      Int
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  description  String?    @db.Text
  tags         String[] // freeform, e.g. ["field-recording", "water", "granular"]
  kind         SampleKind
  attachmentId Int        @unique
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  imageUrls    String[]   // the cover image first, then up to 3 gallery images
  imageAttachmentIds Int[] // their files, so they are removed (and the quota given back) with the resource
  createdAt    DateTime   @default(now())
  mapNode      ForumMapNode?
  // Paid resources: the file is only handed out to someone who holds a coupon (the artist is given one). Free ones are open to everyone.
  paid         Boolean    @default(false)
  price        String?    // shown as typed, e.g. "5 USD"
  payNote      String?    @db.Text // how to pay, in the admin's words (the PayPal donation button instruction)
  paypalUrl    String?    // the donation button / link for this resource; blank = the site's donate link
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  previewUrl   String?    // a short listen (or a link to one) that the author supplies: shown on the card like the sample on the Contribute page. Public by design.
  previewAttachmentId Int? // the uploaded preview's file, so it is removed (and the quota given back) with the resource
  coupons      ResourceCoupon[]
  unlocks      ResourceUnlock[]
  rewards      Reward[]
  puzzleNodes  PuzzleNode[]
}

// A code that opens paid resources: for one resource, or (itemId null) for every paid one. The admin makes them and hands them to the contributing artists.
model ResourceCoupon {
  id        Int      @id @default(autoincrement())
  code      String   @unique // stored upper-case
  itemId    Int?
  item      SampleBankItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  note      String?  // who it was made for
  maxUses   Int?     // null = unlimited
  uses      Int      @default(0)
  expiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  unlocks   ResourceUnlock[]
}

// A member who has redeemed a coupon keeps the resource unlocked. (Visitors without an account just get the file for that visit.)
model ResourceUnlock {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    Int
  item      SampleBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  couponId  Int?
  coupon    ResourceCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  via       String   @default("coupon") // how it was opened: coupon, points, gift or puzzle
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

// The homepage's "Featured articles": a study, news post or wiki page, picked by the admin with its own preview text and a background picture.
model FeaturedArticle {
  id         Int      @id @default(autoincrement())
  kind       String   // "study" | "news" | "wiki"
  refSlug    String   // the article's slug
  text       String?  @db.Text // the custom preview text
  imageUrl   String?  // chosen from the article's own pictures (or a link)
  imageOpacity Float? // 0.05 - 0.9; null = soft default
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([kind, refSlug])
}

// --- Prompt-based challenges: a recurring constraint with a submission
// thread. Admin-created; any user can submit one of their own community
// tracks against an open challenge.

model Challenge {
  id          Int      @id @default(autoincrement())
  title       String
  prompt      String   @db.Text
  active      Boolean  @default(true)
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  createdAt   DateTime @default(now())

  submissions ChallengeSubmission[]
  mapNode ForumMapNode?
}

model ChallengeSubmission {
  id          Int            @id @default(autoincrement())
  challengeId Int
  challenge   Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  trackId     Int
  track       CommunityTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId      Int
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([challengeId, trackId])
}

// --- Community content: user-submitted music, separate from the curated
// Album/Track models above since it isn't tied to a Branch the way every
// official release is. Uploaded audio reuses the exact same quota-enforced
// Attachment pipeline as message attachments, which also means it already
// shows up in Admin → Storage with the same migrate-to-archive.org tool.

model CommunityAlbum {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug        String   @unique
  title       String
  composer    String
  coverArtUrl String?
  coverAttachmentId Int? @unique
  coverAttachment   Attachment? @relation(fields: [coverAttachmentId], references: [id])
  description String?  @db.Text
  createdAt   DateTime @default(now())

  targetBranchId    Int?
  targetBranch      Branch?           @relation("BranchSubmissions", fields: [targetBranchId], references: [id])
  submissionStatus  SubmissionStatus?
  submissionChannelId Int?            @unique
  submissionChannel   ForumChannel?   @relation(fields: [submissionChannelId], references: [id], onDelete: SetNull)

  tracks CommunityTrack[]
  pointsEntries ContributorPointsEntry[]
  claimedWanted BranchWanted[]
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// A ledger, not a single counter, so awards stay auditable (who gave
// how many points, when, and why) and can come from more than just
// approved submissions - admin can award points manually too. Visible
// to admins only.
model ContributorPointsEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  submissionId Int?
  submission   CommunityAlbum? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  awardedById Int?
  awardedBy   User?  @relation("PointsAwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  claim     RewardClaim? // set on the spending entry (negative points) made when a reward was claimed
}

enum TrackPermission {
  LISTEN_ONLY
  CREDIT_REQUIRED
  FREE_REMIX
}

model CommunityTrack {
  id              Int            @id @default(autoincrement())
  albumId         Int
  album           CommunityAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title           String
  composer        String? // per-track override; falls back to the album's composer when unset
  attachmentId    Int?           @unique // set when the user uploaded a file directly
  attachment      Attachment?    @relation(fields: [attachmentId], references: [id])
  externalUrl     String? // set instead of attachmentId when linking an already-hosted file
  format          AudioFormat
  durationSeconds Int?
  position        Int            @default(0)
  permission      TrackPermission @default(LISTEN_ONLY) // creator-set: how others may use this track
  replayGainDb    Float? @map("replay_gain_db_v2") // sitewide loudness normalization (target -11 LUFS, boost limited by peak) - null means not yet analyzed. The column name changed with the target so every track is measured afresh.
  lyrics          String? // also acts as a description; shown expandable on the album page and playlist list view
  genres          String[] @default([]) // user-assigned, as many as wanted - drives Venn Views placement

  playlistItems PlaylistItem[]
  likes         CommunityTrackLike[]
  comments      CommunityTrackComment[]
  revisions     CommunityTrackRevision[]
  remixOfId     Int?
  remixOf       CommunityTrack?  @relation("Remixes", fields: [remixOfId], references: [id], onDelete: SetNull)
  remixes       CommunityTrack[] @relation("Remixes")
  challengeSubmissions ChallengeSubmission[]
  sampleForBranches Branch[] @relation("BranchSampleCommunityTrack")
}

// A lightweight "resonate" signal - deliberately simpler than the full
// emoji-reaction system chat uses, just a single toggle per user per track.
model CommunityTrackLike {
  id        Int            @id @default(autoincrement())
  trackId   Int
  track     CommunityTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([trackId, userId])
}

model Playlist {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug        String   @unique
  title       String
  description String?  @db.Text
  fxSettingsJson Json? // owner-customizable visual controls for this playlist's spacemap view - null means "use the same defaults as the main spacemap"
  previewImageUrl String? // generated SVG snapshot of the whole spacemap, regenerated whenever tracks change
  createdAt   DateTime @default(now())

  items PlaylistItem[]
  collaborators PlaylistCollaborator[]
  mapNode ForumMapNode?
}

// Anyone the owner adds here can add/remove tracks too - a genuinely
// shared, multi-person playlist rather than a solo one. The owner alone
// can add/remove collaborators or delete the playlist itself.
model PlaylistCollaborator {
  id         Int      @id @default(autoincrement())
  playlistId Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([playlistId, userId])
}

// Exactly one of trackId (an official release) / communityTrackId (a
// user-submitted one) is set per row - a playlist can freely mix both.
model PlaylistItem {
  id               Int             @id @default(autoincrement())
  playlistId       Int
  playlist         Playlist        @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId          Int?
  track            Track?          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  communityTrackId Int?
  communityTrack   CommunityTrack? @relation(fields: [communityTrackId], references: [id], onDelete: Cascade)
  position         Int             @default(0)
}

// How people actually move between things on the site: one row per ordered pair of entities (e.g. "study:beating-tones" -> "branch:ambient"),
// counted in aggregate only (no per-person trail). The strongest routes out of a page are shown in its margins once enough people have taken them.
model EdgeCount {
  from      String
  to        String
  n         Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([from, to])
  @@index([from, n])
}

// Something a member can spend contributor points on. A reward linked to a paid resource opens it at once; any other reward (a callsign suffix,
// early access, a featured slot...) lands in the admin's queue to be fulfilled by hand. The points themselves live in ContributorPointsEntry.
model Reward {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  cost        Int
  itemId      Int?
  item        SampleBankItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  perUser     Int      @default(1) // how many times one member may claim it
  stock       Int?     // how many are left; null = no limit
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  claims      RewardClaim[]
}

model RewardClaim {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId    Int
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  cost        Int      // what it cost at the time
  entryId     Int?     @unique
  entry       ContributorPointsEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  status      String   @default("pending") // pending (waiting for the team), fulfilled, refunded
  note        String?
  createdAt   DateTime @default(now())
  fulfilledAt DateTime?

  @@index([userId])
  @@index([status])
}

// A testable claim with a protocol. Anyone can try it; the tally says how it is going, the author says what it means.
model Hypothesis {
  id            Int      @id @default(autoincrement())
  authorId      Int
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  claim         String   @db.Text   // one sentence a test could show wrong
  protocol      String   @db.Text   // how to test it and what counts as yes
  requirements  String[]            // e.g. "headphones", "quiet room"
  status        String   @default("open") // open | testing | supported | contested | refuted | inconclusive
  statusNote    String?
  question      String?             // the one-tap question for an A/B test ("Which sounds brighter?"); the claim predicts A
  stimulusAUrl  String?
  stimulusBUrl  String?
  stimulusAAttachmentId Int?
  stimulusBAttachmentId Int?
  studyId       Int?
  study         Study?   @relation(fields: [studyId], references: [id], onDelete: SetNull)
  bonusPaid     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trials        Trial[]

  @@index([status])
}

// One answer from one participant (a member, or an anonymous browser token that is only ever stored hashed).
model Trial {
  id           Int        @id @default(autoincrement())
  hypothesisId Int
  hypothesis   Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  who          String     // "u:<id>" or "p:<sha256 of the token>"
  pick         String     // claim | other | unsure (in the hypothesis's own terms)
  note         String?
  createdAt    DateTime   @default(now())

  @@unique([hypothesisId, who])
  @@index([hypothesisId])
}

// A drawn letter (ink, placed text, stamps). Either sent to one member (optionally held back: slow post) or left on a place for whoever turns on the Trace lens there.
model Letter {
  id         Int       @id @default(autoincrement())
  authorId   Int
  author     User      @relation("LetterAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  toUserId   Int?
  toUser     User?     @relation("LetterTo", fields: [toUserId], references: [id], onDelete: Cascade)
  entityKey  String?   // "study:beating-tones" for a mark left on a place
  posX       Float?    // where on the page a mark was written with the Scan Visor: fraction of the page width (0..1)
  posY       Float?    // ... and pixels from the top of the page (0..20000). Null for marks drawn on the sheet, which the visor scatters.
  doc        Json
  unsigned   Boolean   @default(false) // a mark on a place may hide its author from readers (admins still see)
  deliverAt  DateTime  @default(now())
  openedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([toUserId, deliverAt])
  @@index([authorId, createdAt])
  @@index([entityKey, expiresAt])
}

model LetterBlock {
  blockerId Int
  blocker   User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

// One vote per member on a poll or A/B message (changeable). Counts stay hidden until you have voted.
model PollVote {
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    Int
  updatedAt DateTime @updatedAt

  @@id([messageId, userId])
}

// The numbers station's puzzle graph. A node is a transmission, optionally with an answer. Hidden nodes are never sent to players.
model PuzzleNode {
  id          Int      @id @default(autoincrement())
  title       String
  body        String   @db.Text
  mediaUrl    String?  // audio / image, an https link or an /uploads path (lossless WAV/FLAC are fine)
  hint        String?  @db.Text
  answerSalt  String?
  answerHash  String?  // sha256(salt:normalised answer). null = no answer: the player just receives it
  requires    Int[]    // node ids that must be met first
  quorum      Int      @default(0) // > 0: a collective lock. Whatever requires it waits until this many members have solved it
  opensOnDay  Int?     // station day index (see lib/signal.ts); null = no date
  rewardText  String?  @db.Text
  rewardUrl   String?
  rewardPoints Int     @default(0)
  rewardItemId Int?
  rewardItem  SampleBankItem? @relation(fields: [rewardItemId], references: [id], onDelete: SetNull)
  published   Boolean  @default(false)
  x           Float?   // editor position, optional
  y           Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  solves      PuzzleSolve[]
}

model PuzzleSolve {
  nodeId Int
  node   PuzzleNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId Int
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  at     DateTime   @default(now())

  @@id([nodeId, userId])
  @@index([nodeId])
}

// ---- Outreach: a private contact sheet and email composer for the site owner (festivals, open calls, labels...) ----
model OutreachSettings {
  id              Int      @id @default(1)
  smtpHost        String?
  smtpPort        Int?
  smtpSecure      Boolean  @default(true)
  smtpUser        String?
  smtpPasswordEnc String? // sealed with OUTREACH_SECRET (or JWT_SECRET); never sent to the browser
  fromName        String?
  fromEmail       String?
  replyTo         String?
  defaultCc       String? // comma separated
  defaultBcc      String?
  imapHost        String?
  imapPort        Int?
  imapSecure      Boolean  @default(true)
  sentFolder      String   @default("Sent")
  fileInSent      Boolean  @default(false) // put a copy in the mailbox's Sent folder over IMAP (providers like Gmail do this by themselves)
  signatureMd     String   @default("")
  followUpDays    Int      @default(14)
  updatedAt       DateTime @updatedAt
}

model OutreachColumn {
  id       Int     @id @default(autoincrement())
  workspaceId Int?
  key      String  // the merge-field name: {{key}} (unique inside a workspace)
  name     String
  type     String  @default("text") // text, longtext, number, date, checkbox, select, multiselect, url, email, rating
  options  Json?   // for select / multiselect: ["Open", "Closed"]
  position Int     @default(0)
  hidden   Boolean @default(false)
  width    Int?

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model OutreachContact {
  id         Int       @id @default(autoincrement())
  workspaceId Int?
  place      String    @default("") // where the call / venue is, as written
  lat        Float?
  lng        Float?
  source     String?   // capture, form, feed, newsletter, eml, import
  doNotContact Boolean @default(false)
  snoozeReason String?
  declineReason String?
  reopensAt  DateTime?  // a recurring call: when it usually opens again
  name       String    @default("")
  email      String    @default("")
  data       Json      @default("{}") // column key -> value
  lastSentAt DateTime? // editable: for mail that was not sent from here
  sentCount  Int       @default(0)  // editable too
  followUpAt DateTime?
  status     String    @default("") // pipeline: "" / lead, contacted, replied, accepted, declined, ghosted
  deadline   DateTime? // an open call's closing date
  repliedAt  DateTime?
  timezone   String? // IANA name, for "send at 10:00 their time"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sends      OutreachSend[]
  scheduled  OutreachScheduled[]
  groups     OutreachGroup[]

  @@index([followUpAt])
  @@index([workspaceId])
}

model OutreachGroup {
  id       Int               @id @default(autoincrement())
  workspaceId Int?
  name     String
  position Int               @default(0)
  contacts OutreachContact[]

  @@unique([workspaceId, name])
}

model OutreachSend {
  id          Int              @id @default(autoincrement())
  workspaceId Int?
  accountId   Int?             // which mailbox it went out from
  subjectVariant String?       // "A" / "B" when two subjects were compared
  source      String?          // null = sent from here, "eml" = imported from a mail file
  contactId   Int?
  contact     OutreachContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  toEmail     String
  toName      String           @default("")
  subject     String
  bodyMd      String
  cc          String?
  bcc         String?
  messageId   String?
  filedInSent Boolean          @default(false)
  error       String?
  batch       String?
  templateName String?
  blocksUsed  Json? // [{kind, blockId}] the variants this person got
  sentAt      DateTime         @default(now())

  @@index([contactId, sentAt])
  @@index([sentAt])
  @@index([workspaceId])
}

model OutreachBlockType {
  id       Int             @id @default(autoincrement())
  workspaceId Int?
  name     String
  position Int             @default(0)
  blocks   OutreachBlock[]
}

model OutreachBlock {
  id        Int               @id @default(autoincrement())
  typeId    Int
  type      OutreachBlockType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  title     String
  body      String            @default("")
  position  Int               @default(0)
  updatedAt DateTime          @updatedAt
}

model OutreachTemplate {
  id        Int      @id @default(autoincrement())
  workspaceId Int?
  name      String
  subject   String   @default("")
  bodyMd    String   @default("")
  rules     Json     @default("[]") // [{kind, group|null, blockId}]
  updatedAt DateTime @updatedAt
}

model OutreachScheduled {
  id        Int              @id @default(autoincrement())
  workspaceId Int?
  contactId Int?
  contact   OutreachContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  toEmail   String
  toName    String           @default("")
  subject   String
  sendAt    DateTime
  status    String           @default("pending") // pending, sending, sent, failed, cancelled
  payload   Json // the compose body for this one recipient
  error     String?
  createdAt DateTime         @default(now())

  @@index([status, sendAt])
}

// ---- Outreach workspaces: one per artist, entered with a shared password (no site login needed) ----
model OutreachWorkspace {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  name         String
  passwordHash String
  tokenVersion Int       @default(0) // bumping it signs everybody out
  trackLinks   Boolean   @default(false)
  dnc          Json      @default("[]") // do-not-contact: emails or "@domain"
  profile      Json      @default("{}") // fit profile: keywords, maxFee, yearlyBudget, regions
  attachRules  Json      @default("[]") // [{group, fileId}] a file that goes with everyone in a group
  digestOn     Boolean   @default(false)
  digestAt     DateTime?
  createdAt    DateTime  @default(now())
}

// A mailbox the workspace can send from ("Send as X"). The password is sealed like the old single account's.
model OutreachAccount {
  id              Int      @id @default(autoincrement())
  workspaceId     Int?
  label           String   @default("")
  position        Int      @default(0)
  isDefault       Boolean  @default(false)
  smtpHost        String?
  smtpPort        Int?
  smtpSecure      Boolean  @default(true)
  smtpUser        String?
  smtpPasswordEnc String?
  fromName        String?
  fromEmail       String?
  replyTo         String?
  defaultCc       String?
  defaultBcc      String?
  imapHost        String?
  imapPort        Int?
  imapSecure      Boolean  @default(true)
  sentFolder      String   @default("Sent")
  fileInSent      Boolean  @default(false)
  signatureMd     String   @default("")
  followUpDays    Int      @default(14)
  // looking for open calls in the INBOX (read-only)
  inboxOn         Boolean   @default(false)
  inboxFolder     String    @default("INBOX")
  inboxLastUid    Int       @default(0)
  inboxValidity   String?
  inboxCheckedAt  DateTime?
  inboxError      String?
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
}

// Files that can be used again, in groups ("press photos", "stereo masters").
model OutreachFileGroup {
  id          Int    @id @default(autoincrement())
  workspaceId Int?
  name        String
  position    Int    @default(0)

  @@index([workspaceId])
}

model OutreachFile {
  id          Int      @id @default(autoincrement())
  workspaceId Int?
  groupId     Int?
  name        String
  url         String
  mimeType    String   @default("")
  sizeBytes   Int      @default(0)
  hash        String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, groupId])
}

// Mail read from .eml files (and the viewer's source): application mail or stray.
model OutreachMessage {
  id          Int       @id @default(autoincrement())
  workspaceId Int?
  contactId   Int?
  direction   String    @default("in") // in / out
  fromEmail   String    @default("")
  fromName    String    @default("")
  toEmails    String    @default("")
  subject     String    @default("")
  date        DateTime
  messageId   String?
  inReplyTo   String?
  bodyText    String    @default("")
  kind        String    @default("application") // application / stray
  reason      String    @default("")
  hint        String?   // looks like: decline, acceptance, ...
  attachments Json      @default("[]") // [{name, size}] names only
  createdAt   DateTime  @default(now())

  @@index([workspaceId, date])
  @@index([workspaceId, messageId])
  @@index([contactId])
}

// Calls found by a feed, a pasted newsletter, the bookmarklet or a form: wait here until kept or dismissed.
model OutreachFeed {
  id            Int       @id @default(autoincrement())
  workspaceId   Int?
  url           String
  title         String    @default("")
  active        Boolean   @default(true)
  lastCheckedAt DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([workspaceId])
}

model OutreachLead {
  id          Int      @id @default(autoincrement())
  workspaceId Int?
  feedId      Int?
  title       String
  url         String   @default("")
  summary     String   @default("")
  deadline    DateTime?
  fee         String?
  place       String   @default("")
  emails      Json     @default("[]")
  fields      Json     @default("[]") // form questions, when it came from a form
  source      String   @default("feed") // feed, newsletter, bookmarklet, form, inbox, eml
  status      String   @default("new") // new, kept, dismissed
  key         String   // dedupe: url or title
  foundAt     DateTime @default(now())

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

// Tracked links: a plain redirect that counts clicks.
model OutreachLink {
  id          Int       @id @default(autoincrement())
  workspaceId Int?
  code        String    @unique
  url         String
  contactId   Int?
  clicks      Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, contactId])
}

// A named sonic phenomenon (beating, aliasing...) explained on a card: a short summary, notes, an example track, and optionally the effects chain that reproduces it.
model Phenomenon {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  title      String
  summary    String   @default("")
  body       String   @default("") @db.Text
  chain      String?  // the shareable chain (lib/dsp/chainLink) that reproduces it in the Effects tab
  exampleTrackId Int?
  exampleTrack   Track? @relation("PhenomenonExample", fields: [exampleTrackId], references: [id], onDelete: SetNull)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A term of the XenoLab glossary. Terms (and their aliases) are auto-linked in studies and articles; the Glossary page is any wiki page that contains a {glossary} line.
model GlossaryTerm {
  id         Int      @id @default(autoincrement())
  term       String   @unique
  aliases    String[] @default([])
  definition String   @db.Text
  updatedAt  DateTime @updatedAt
}

// Each approved newcomer is paired with one existing member, who gets a single prompt to say hello.
model WelcomeBuddy {
  id        Int       @id @default(autoincrement())
  newUserId Int       @unique
  newUser   User      @relation("WelcomeNew", fields: [newUserId], references: [id], onDelete: Cascade)
  buddyId   Int
  buddy     User      @relation("WelcomeBuddy", fields: [buddyId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  doneAt    DateTime? // said hello, or skipped

  @@index([buddyId, doneAt])
}

// An earlier version of a community track, kept when its owner uploads a new file. A version can say which pinned comment it answers.
// At most 3 are kept per track (their files count towards the owner's storage).
model CommunityTrackRevision {
  id              Int            @id @default(autoincrement())
  trackId         Int
  track           CommunityTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  attachmentId    Int?
  attachment      Attachment?    @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  externalUrl     String?
  answersCommentId Int?
  answersComment  CommunityTrackComment? @relation(fields: [answersCommentId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([trackId, createdAt])
}

// A slot a branch is asking for ("a 30 s drone in D", "field recording of rain"). A submission may claim an open one; the claim frees up if the album goes away or is rejected.
model BranchWanted {
  id       Int    @id @default(autoincrement())
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title    String
  detail   String @default("")
  position Int    @default(0)
  claimedAlbumId Int?
  claimedAlbum   CommunityAlbum? @relation(fields: [claimedAlbumId], references: [id], onDelete: SetNull)
  claimedAt DateTime?
  @@index([branchId, position])
}

// Radio plays one branch at a time. A block says "from this UTC hour, for this many hours, play this branch"; hours without a block rotate through the branches.
model RadioBlock {
  id        Int    @id @default(autoincrement())
  branchId  Int
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startHour Int    // 0-23, UTC
  hours     Int    // 1-24
  @@index([startHour])
}
