DATABASE_URL="postgresql://exomusica:changeme@postgres:5432/exomusica"
# Required. Generate one with: openssl rand -hex 32. The server will not start without a real value (32+ characters).
JWT_SECRET=
# Browsers allowed to call the API from a page script (comma-separated). Same-site pages need no entry.
CORS_ORIGINS=https://exomusica.com
LOG_LEVEL=info
PORT=3001

# Email — leave SMTP_HOST unset to disable sending entirely (features that
# would send email just log instead of failing). Never commit real values
# here; fill this file in directly on the server, not in git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@exomusica.com
